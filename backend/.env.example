# Copy this file to `.env` to override defaults. `.env` is git-ignored.
# AI runs locally via Ollama, so there is no API key to configure.

# Ollama server + model (optional — these are the built-in defaults).
# Requires `ollama serve` running and `ollama pull qwen2.5-coder:3b`.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# OLLAMA_TIMEOUT=120   # seconds to wait for a generation (CPU can be slow)

# SQLite database file location (relative to the backend/ directory)
DATABASE_URL=sqlite:///./codementor.db  
